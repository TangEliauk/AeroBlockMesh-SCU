# Large data stays local; published UIUC v1 and split manifests stay versioned.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/uiuc_v1/
!/data/processed/block_topology_v1/
!/data/processed/block_topology_2d_v1/
/data/expert/*
!/data/expert/.gitkeep

# Generated experiment artifacts
/experiments/checkpoints/*
!/experiments/checkpoints/.gitkeep
/experiments/logs/*
!/experiments/logs/.gitkeep
/experiments/results/*
!/experiments/results/.gitkeep
!/experiments/results/airfoil_fusion_20261128/
